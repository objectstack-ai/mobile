# Server URL pre-filled on the server picker (optional)
EXPO_PUBLIC_DEFAULT_SERVER_URL=http://localhost:3000

# Extra hosts allowed to load inside the WebView, comma-separated (e.g. your SSO IdP)
EXPO_PUBLIC_TRUSTED_HOSTS=

# Sentry DSN for crash reporting (optional)
EXPO_PUBLIC_SENTRY_DSN=

# App deep linking scheme
EXPO_PUBLIC_APP_SCHEME=objectstack
